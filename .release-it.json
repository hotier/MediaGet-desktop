{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "hooks": {
    "before:init": ["pnpm typecheck", "pnpm lint", "pnpm test"],
    "after:bump": ["node scripts/build-landing.cjs", "git add landing/version.json"]
  },
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireCommits": true,
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "v${version}"
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "header": "# 更新日志\n\n本文件由 `pnpm release` 按 commit 前缀生成；用户可见的变化请在此基础上补一句人话。",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          { "type": "feat", "section": "新增" },
          { "type": "fix", "section": "修复" },
          { "type": "perf", "section": "性能" },
          { "type": "refactor", "section": "重构", "effect": "hidden" },
          { "type": "docs", "effect": "hidden" },
          { "type": "build", "effect": "hidden" },
          { "type": "ci", "effect": "hidden" },
          { "type": "test", "effect": "hidden" },
          { "type": "style", "effect": "hidden" },
          { "type": "chore", "effect": "hidden" },
          { "type": "revert", "section": "回退" }
        ]
      }
    }
  }
}
