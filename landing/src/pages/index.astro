                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                    <path d="M3 3v5h5" />
                    <path d="M12 7v5l4 2" />
                  </svg>
                  <span>历史</span>
                </label>
                <label class="app-nav-item" for="tour-stats">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                    <path d="m7 13 3-3 4 4 5-5" />
                  </svg>
                  <span>统计</span>
                </label>
              </nav>

              <!-- 设置态的侧栏整壳换成分类表（真应用的 settingsMode 就是这个动作）。
                   分类画成不可点：这里只复刻「引擎」一面，做成能点就等于承诺另外四面也在。 -->
              <div class="app-side-set">
                <label class="app-back" for="tour-home">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                  </svg>
                  <span>返回</span>
                  <em>Esc</em>
                </label>
                <span class="app-cat">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M3 20h9M16 20h5" />
                    <path d="M14 2v4M8 10v4M16 18v4" />
                  </svg>
                  <span>通用</span>
                </span>
                <span class="app-cat">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <path d="m7 10 5 5 5-5" />
                    <path d="M12 15V3" />
                  </svg>
                  <span>下载</span>
                </span>
                <span class="app-cat">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2a1 1 0 0 0 0 20l.25 0a1.75 1.75 0 0 0 1.4-2.8l-.3-.4a1.75 1.75 0 0 1 1.4-2.8h2.25a5 5 0 0 0 5-5 10 9 0 0 0-10-9z" />
                    <circle cx="6.5" cy="12.5" r=".5" />
                    <circle cx="8.5" cy="7.5" r=".5" />
                    <circle cx="13.5" cy="6.5" r=".5" />
                    <circle cx="17.5" cy="10.5" r=".5" />
                  </svg>
                  <span>外观</span>
                </span>
                <span class="app-cat is-on">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="4" y="4" width="16" height="16" rx="2" />
                    <rect x="9" y="9" width="6" height="6" rx="1" />
                    <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" />
                  </svg>
                  <span>引擎</span>
                </span>
                <span class="app-cat">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" />
                    <path d="m15 9-6 6" />
                    <path d="M9 9h.01" />
