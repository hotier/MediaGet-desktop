---
/*
 * MediaGet 落地页（Astro 静态页，不参与 renderer 构建，也不 import 应用运行时模块）。
 *
 * 风格基准：克制的技术感——全页只有一个强视觉记忆点（首屏 WebGL 奇点），
 * 其余区域用大留白与排版分割，不使用装饰性卡片、阴影与插图。
 * 唯一的例外是第 01 段的应用界面模拟：它按 renderer 的真值复刻窗口（含卡片与描边），
 * 装得越像应用，读者越不需要读文案就知道这工具能干什么。
 *
 * 平台带不在这里抄名字：清单直接 import shared/platforms.ts（与主进程、渲染层同一张表），
 * 图标由 scripts/build-landing.cjs 从 renderer/public/logos 镜像到 landing/public/logos（生成物，不入库）。
 * 在这里手抄一份平台名或数量就是第二真源——加平台时它不会变红，只会静默少一个。
 *
 * 版本号来自 version.json（同一脚本在构建时产出；仓库内始终保留一份本地默认值，
 * 未执行脚本也不会拿到空值白屏）。下载入口只有首屏那一枚按钮，指向 releases/latest，
 * 所以安装包体积与发布日期不再抄进页面——那两个数是 Release 那页的真值，抄过来只会落后。
 */
import "../styles/global.css";
import { PLATFORMS } from "../../../shared/platforms";
import { WORK_STAT_SLOTS } from "../../../shared/work-stat";
import release from "../../version.json";

const REPO_FALLBACK = "hotier/mediaGet-desktop";
const repo = release.repo || REPO_FALLBACK;
const releasesLatest = `https://github.com/${repo}/releases/latest`;

// 只有默认提供的平台才上首页：登记了但引擎未验证（enabledByDefault=false）的不在这里承诺。
const supplied = PLATFORMS.filter((platform) => platform.enabledByDefault);
const platformCount = supplied.length;

/** 图标光学尺寸分档：源文件 viewBox 比例不同，属落地页自己的视觉元数据，按契约键挂载 */
const iconFit: Record<string, "wide" | "wordmark" | "chip"> = {
  youtube: "wide",
  acfun: "wordmark",
  twitter: "chip",
};

/**
 * 界面模拟（第 01 段）里的平台图标与计数标签一律回注册表取，不在这里抄第二份：
 * 查不到就当场抛错让 astro build 变红，比页面上静默少一枚图、少一个字好发现。
 */
const logoBy = new Map(PLATFORMS.map((platform) => [platform.key, platform.iconFile]));
const logo = (key: string) => {
  const file = logoBy.get(key);
  if (!file) throw new Error(`界面模拟引用了未登记的平台键 "${key}"：shared/platforms.ts 里没有它`);
  return file;
};
const statLabel = (key: string) => {
  const slot = WORK_STAT_SLOTS.find((item) => item.key === key);
  if (!slot) throw new Error(`界面模拟引用了未登记的计数字段 "${key}"：shared/work-stat.ts 里没有它`);
  return slot.label;
};

/** 数值取自 renderer/src/dev/mock-bridge.ts 的 bilibili 夹具；这是演示数据，不是实测统计 */
const DEMO_STAT: Record<string, number> = { view: 1284503, danmaku: 8421, like: 98200 };
const statRow = ["view", "danmaku", "like"].map((key) => ({
  label: statLabel(key),
  value: DEMO_STAT[key],
}));

/**
 * 星期轴与 renderer/src/lib/stats.ts 的 WEEKDAYS 同序（索引 = getDay()）。
 * 热力 7 行 × 12 格，一格两小时；真页是 7×24=168 格，这里收一档，168 枚方块在落地页只增体积不增信息。
 * 数字是密度档（0–3），不是计数。
 */
const WEEKDAYS = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
const HEAT = [
  "000001001110",
  "001122101220",
  "012332123321",
  "012331023320",
  "001221012210",
  "000110001110",
  "000011011221",
].map((row) => row.split("").map(Number));

const version = release.version || "0.1.0";
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MediaGet — 粘贴一条链接，剩下的交给你的电脑</title>
    <meta
      name="description"
      content={`MediaGet 是一款 Windows 桌面视频下载器：解析与下载都在本机完成，链接不经过第三方服务器，直链拿到就落盘。支持 ${platformCount} 个平台，含资源列表预览与断点续传，Cookie 只存本机。`}
    />
    <meta name="theme-color" content="#08090b" />
    <meta property="og:title" content="MediaGet — 本地解析、本地下载" />
    <meta
      property="og:description"
      content="粘贴一条链接。解析、预览与下载，都在你自己的电脑上完成。"
    />
    <meta property="og:type" content="website" />
    <!-- 绝对链接来自 astro.config 的 site（Pages 项目站），页面里不写死域名 -->
    <link rel="canonical" href={Astro.site?.href} />
    <meta property="og:url" content={Astro.site?.href} />
    <meta property="og:site_name" content="MediaGet" />
    <meta name="twitter:card" content="summary" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%234b8dff'/%3E%3Cpath d='M16 8v10m0 0 4-4m-4 4-4-4M9.5 22.5h13' stroke='%23fff' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E"
    />
    <script is:inline>
      /* 主题：head 里定初值，并把开关也挂在这里。
         ?theme=light|dark 可强制预览某一主题（不写入存储）。
         开关只能活在这段内联脚本里，不能交给 src/scripts/main.js：那个入口被打成
         type="module"，file:// 下模块脚本会被 CORS 拦掉，监听器挂不上去，按钮就成了死键。
         同一条理由也限制了这里能做什么——初值必须在 CSS 与正文之前定下来，而 html.js 标记
         绝不能跟进来：内联脚本在 file:// 下照样执行，标记一打，正文就按 CSS 藏进 opacity:0，
         而负责揭示的模块永远不来，页面比不做动画更糟（整页空白）。标记留给 main.js。 */
      (function () {
        var root = document.documentElement;

        function applySavedTheme() {
          try {
            var forced = new URLSearchParams(location.search).get("theme");
            var saved = forced || localStorage.getItem("mg-landing-theme");
            if (saved === "light" || saved === "dark") root.dataset.theme = saved;
          } catch (error) {
            /* 存储不可用时保持默认深色 */
          }
        }

        /* 按钮文案、tooltip 与 theme-color 跟着主题走；head 阶段正文还没出来，所以只在 DOM 就绪后调用 */
        function syncChrome(theme) {
          var toLight = theme !== "light";
          var label = toLight ? "切换到浅色主题" : "切换到深色主题";
          var toggle = document.getElementById("themeToggle");
          if (toggle) {
            toggle.setAttribute("aria-label", label);
            toggle.setAttribute("title", label);
          }
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", toLight ? "#08090b" : "#f5f6f8");
        }

        applySavedTheme();

        document.addEventListener("DOMContentLoaded", function () {
          var toggle = document.getElementById("themeToggle");
          syncChrome(root.dataset.theme);
          if (!toggle) return;
          toggle.addEventListener("click", function () {
            var theme = root.dataset.theme === "light" ? "dark" : "light";
            root.dataset.theme = theme;
            try {
              localStorage.setItem("mg-landing-theme", theme);
            } catch (error) {
              /* 隐私模式禁用存储时仅本次会话生效 */
            }
            syncChrome(theme);
            /* 首屏 WebGL island 在跑，靠这个事件换粒子配色 */
            document.dispatchEvent(new CustomEvent("mg:theme", { detail: { theme: theme } }));
          });
        });
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>

    <header class="nav" id="nav">
      <div class="nav-inner">
