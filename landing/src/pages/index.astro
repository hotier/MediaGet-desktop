          <div class="section-head">
            <h2>常见问题</h2>
          </div>

          <div class="section-body faq">
            <!-- 一律收起，不给任何一条加 open：首条展开会让「问答」段在首屏外先露出一段
                 长文本，和其他五条的扫读节奏不一致（业主 2026-10-22 指出）。 -->
            <details>
              <summary>和在线解析网站有什么区别？</summary>
              <p>
                在线站点先把链接提交到它的服务器排队解析；MediaGet
                在本机直接运行对应平台的解析器，链接不经过第三方队列，直链拿到就落盘，不会出现「复制出去就过期」。
              </p>
            </details>
            <details>
              <summary>需要注册或登录吗？</summary>
              <p>
                不需要注册账号。抖音、小红书、Instagram 等需要登录态的平台，可以在设置里用内置窗口登录获取
                Cookie，也可以手动粘贴，两条路都只保存在本机。
              </p>
            </details>
            <details>
              <summary>Cookie 会被上传吗？</summary>
              <p>
                不会。Cookie 只写进本机的 userData 配置，界面与日志里始终以掩码出现；获取它的登录窗口也由主进程自己加载，不经过第三方服务器。
              </p>
            </details>
            <details>
              <summary>解析失败怎么办？</summary>
              <p>
                先看设置里的「引擎体检」：它会逐平台标注由哪个引擎解、当前是否被关掉。需要登录态的平台，补上
                Cookie 往往就能过；被关掉的平台也可以在那里重新打开。
              </p>
            </details>
            <!-- 2026-10-22 无障碍与内容体检补的两问：下载器用户最本能的两条异议
                 （安全吗 / 我的系统有没有）此前只在条款页与文案缝里，FAQ 这个扫读入口没接住。
                 口径全部对齐既有承诺：MIT 开源、本机运行、不静默安装（用户协议第九条）、
                 仅 Windows。不写未实现的承诺。 -->
            <details>
              <summary>它安全吗？会不会带毒或偷偷常驻？</summary>
              <p>
                软件以 MIT 许可开源，源码公开可审。它只在你点下「下载」的那台电脑上运行：不装系统服务、不驻后台、不碰浏览器，更新也要你确认后才安装。安装包请只认本仓库
                Release 页的那一份——同名仿冒站是这类工具最常见的风险来源。
              </p>
            </details>
            <details>
              <summary>Mac 或 Linux 能用吗？</summary>
              <p>
                当前只出 Windows 版（10/11），没有 Mac 与 Linux 的安装包。界面按桌面窗口设计，网页版或手机版也不在计划里——它要用的解析内核与文件写入都发生在你的本机。
              </p>
            </details>
          </div>
        </div>
      </section>
    </main>

    <!-- 页脚由 components/SiteFooter.astro 提供：文档页与 404 用的是同一个组件，只是锚点前缀不同 -->
    <SiteFooter pagePath="/" isHome />

    <!-- 首屏副文案的轮换打字机。
         为什么是内联脚本、而不是 src/scripts 里的模块：file:// 下模块脚本会被 CORS 拦掉，
         而这段只是给一行字做逐字播放，双击 dist/index.html 也该看到它动。
         为什么脚本、而不是纯 CSS：轮换要记「说到第几句、擦到第几个字」，纯 CSS 只能靠层层
         animation-delay 硬拼时间线，改一条文案就得重算全部延迟。代价是它只在 JS 可用时跑，
         所以第一句完整写在 HTML 里，这里只是接管，不负责让内容出现。 -->
    <script is:inline define:vars={{ lines: heroLines }}>
      (function () {
        var text = document.getElementById("heroTicker");
        var sub = text && text.closest(".hero-sub");
        if (!text || !sub) return;
        /* 读者要减少动态效果时不接管：留第一句静态文案，连光标都不加 */
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        /* 四个节奏参数。注释全写在行上方：本仓的字体覆盖守卫只剥整行注释，
           写在行尾的中文会被当成「页面文案」要求进字体子集。 */
        var TYPE = 88;
        var ERASE = 34;
        var HOLD = 2100;
        var GAP = 420;
        var index = 0;
        /* 首句进页面时就是满的，所以第一拍是「停住」而不是「打字」 */
        var pos = lines[0].length;
        var phase = "hold";

        sub.classList.add("is-typing");

        /* 「这一层在编排动画」的广播：模拟窗的倾斜跟着让位（landing/src/lib/tilt.ts）。
           只让首屏入场那一轮：打字机是无限循环的，若每圈都让位，窗就每两秒被扛平一次，
           读起来是「一直在抖」而不是「跟着我走」。首屏那一轮是唯一和入场标题抢注意力的
           时机；循环稳定之后，副文案的逐字变化属于背景节律，不该再打断指针跟随。
           用事件而不是让两边共享变量：倾斜模块可以在任意时机挂载，不依赖这支脚本的执行顺序。
           gate() 自己判重：打字是逐字符推进的，每拍都投事件等于每秒十几个无用工。 */
        var gated = false;
        var firstRound = true;
        function gate(active) {
          if (gated === active) return;
          gated = active;
          document.dispatchEvent(new CustomEvent("mg:tilt", { detail: { active: active } }));
        }

        function step() {
          var line = lines[index];
          if (phase === "hold") {
            phase = "erase";
            return setTimeout(step, HOLD);
          }
          if (phase === "erase") {
            if (firstRound) gate(true);
            pos -= 1;
            text.textContent = line.slice(0, pos > 0 ? pos : 0);
            if (pos <= 0) {
              index = (index + 1) % lines.length;
              pos = 0;
              phase = "type";
              return setTimeout(step, GAP);
            }
            return setTimeout(step, ERASE);
          }
          if (firstRound) gate(true);
          pos += 1;
          text.textContent = line.slice(0, pos);
          if (pos >= line.length) {
            /* 首轮打完 = 入场动画结束：交还指针跟随，此后不再让位（打字机继续循环，
               但它已经退成背景节律，不该每两秒把窗扛平一次） */
            firstRound = false;
            gate(false);
            phase = "hold";
            return setTimeout(step, HOLD);
          }
          return setTimeout(step, TYPE);
        }

        /* 等首屏标题落位再开口，否则两层动画在抢注意力 */
        setTimeout(step, 900);
      })();
    </script>

    <!-- 模拟窗「重力倾斜」（motion 的 vanilla API，实现在 src/lib/tilt.ts）。
         为什么是模块而不是内联脚本：motion 要先打包，内联进去等于把库源码抄进页面。
         代价是 file:// 双击产物时这支不跑——窗体平放，和「减动偏好」同一条降级。
         闸门事件（mg:tilt）由下面那支打字机脚本投递：逐字播放期间倾斜让位。 -->
    <script>
      import { initTilt } from "../lib/tilt";

      initTilt();
    </script>

    <!-- 滚动入场（.reveal）。
         为什么是内联脚本而不是 scripts/ 里的模块：本页之前那支 main.js 是 type="module"，
         file:// 下会被 CORS 拦掉 —— 于是双击 dist/index.html 时只有首屏那几个写在 CSS 里的
         动画在跑，平台段与问答段一动不动，看起来就像「别处压根没做动画」。
         为什么标记在 body 末尾打、而不是 head 里：head 里打标记时正文还没解析，一旦这脚本
         出问题，内容就永远停在 opacity:0；放这里，隐藏与观察在同一拍发生，脚本不跑就全程可见。 -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var blocks = document.querySelectorAll(".reveal");
        if (!blocks.length) return;

        /* 时延挂在入场选择器真正命中的那一层（CSS 里 `html.js .reveal > *`） */
        function stagger(section) {
          var index = 0;
          Array.prototype.forEach.call(section.children, function (child) {
            child.style.setProperty("--d", index * 70 + "ms");
            index += 1;
          });
        }

        root.classList.add("js");

        if (!("IntersectionObserver" in window)) {
          Array.prototype.forEach.call(blocks, function (section) {
            stagger(section);
            section.classList.add("in");
          });
          return;
        }

        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              stagger(entry.target);
              entry.target.classList.add("in");
              revealObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -6% 0px" }
        );
        Array.prototype.forEach.call(blocks, function (section) {
          revealObserver.observe(section);
        });
      })();
    </script>
  </body>
</html>
