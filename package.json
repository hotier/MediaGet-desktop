{
  "name": "mediaget-desktop",
  "productName": "MediaGet",
  "version": "0.3.0-beta.1",
  "description": "一个多功能资源解析器",
  "main": "dist-electron/main/index.js",
  "author": "hotier",
  "homepage": "https://hotier.github.io/mediaGet-desktop/",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.cjs",
    "dev": "node scripts/fetch-binaries.cjs --soft && concurrently -k -n main,renderer,electron \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsup --watch",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:15433 file:./dist-electron/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:15433 node scripts/launch-electron.cjs .",
    "build": "npm run build:app && electron-builder --win",
    "build:app": "tsup && vite build",
    "brand:assets": "node scripts/make-icons.cjs",
    "fetch:binaries": "node scripts/fetch-binaries.cjs",
    "verify:binaries": "node scripts/fetch-binaries.cjs --verify-only",
    "verify:binaries:release": "node scripts/fetch-binaries.cjs --verify-only --require-all",
    "landing:prepare": "node scripts/build-landing.cjs",
    "landing:prepare:online": "node scripts/build-landing.cjs --online",
    "landing:dev": "pnpm --filter mediaget-landing dev",
    "landing:build": "pnpm --filter mediaget-landing build",
    "landing:build:online": "pnpm --filter mediaget-landing build:online",
    "landing:preview": "pnpm --filter mediaget-landing preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "dependencies": {
    "@ikenxuan/amagi": "7.0.0-beta.9",
    "@mediaget/parse-core": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "^6.8.9",
    "font-list": "^2.1.0",
    "undici": "7.30.0",
    "ytdlp-nodejs": "^3.4.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.0",
    "cookie": "2.0.1",
    "cross-env": "^10.1.0",
    "echarts": "6.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.0",
    "exceljs": "^4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "release-it": "^21.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.4",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "cc.hotier.mediaget.desktop",
    "productName": "MediaGet",
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**",
      "dist-renderer/**",
      "package.json",
      "!dist-electron/**/*.map",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/better-sqlite3/prebuilds/linux-*.node",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-*.node",
      "!node_modules/better-sqlite3/prebuilds/darwin-*.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable",
        "7z"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "hotier",
      "repo": "mediaGet-desktop"
    }
  }
}
