# deps / build
node_modules/
dist/
dist-electron/
dist-renderer/
.astro/
release/
*.tsbuildinfo
.vite/

# 落地页的品牌图标：由 scripts/build-landing.cjs 从 renderer/public/logos 镜像过来（生成物）。
# 图标真源只有一处，第二份入库就会变成「加了平台忘了同步落地页」那种静默缺陷。
landing/public/logos/

# 同理：应用字标与页签图标从 renderer/public/brand 镜像（更上游是 brand/ 母版 + scripts/make-icons.cjs）。
# 注意 landing/public/og.png 不在此列 —— 分享卡只有落地页用，脚本直接产出并入库。
landing/public/brand/

# bundled binaries (fetched by CI / first-run, never in git)
resources/bin/
*.exe

# local config & secrets (user cookies must never be committed)
.config.local.json
config.local.json
.env
.env.*
!.env.example

# 品牌资产的检视表（`node scripts/make-icons.cjs --sheet` 出的六档对照图，人眼看用，不入库）
build/_sheet.png

# electron-builder / updater caches
.cache/
*.7z
*.blockmap
*.zip
latest.yml

# logs & local data
*.log
userData/
download/
Downloads/

# Qoder session artifacts (canvas / credits reports), machine-local
.qoder-credits/

# playwright-cli 会话产物（本机工具留下，不是源码）
.playwright-cli/

# 本机 Python 运行时（pythoncore-3.15-64，非本仓源码也非构建产物，勿入仓）
Python/

# editors / os
.idea/
.vscode/
.DS_Store
Thumbs.db
