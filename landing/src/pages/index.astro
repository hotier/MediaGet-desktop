            </svg>
          </button>
          <a
            class="nav-github"
            href={`https://github.com/${repo}`}
            aria-label="GitHub 仓库"
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"
              />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- 首屏：唯一的强视觉。canvas 由 src/scripts/main.js 按需水合，接管前显示静态海报 -->
      <section class="hero" id="top">
        <div class="hero-stage" aria-hidden="true">
          <div class="hero-poster"></div>
          <div class="hero-rings">
            <i class="ring-core"></i>
            <i class="ring-horizon"></i>
            <i class="ring-accretion"></i>
          </div>
          <canvas id="heroCanvas" class="hero-canvas"></canvas>
          <div class="hero-vignette"></div>
        </div>

        <div class="hero-content">
          <h1 class="hero-title"
            ><span class="word-draw"
              ><span class="word word-hollow">Media</span><i class="pen" aria-hidden="true"></i></span
            ><span class="word word-solid">Get</span></h1
          >
          <p class="hero-sub">粘贴一条链接。解析、预览与下载，都在你自己的电脑上完成。</p>
          <p class="hero-cta">
            <a class="cta-primary" href={releasesLatest} target="_blank" rel="noopener"
              >下载 Windows 版</a
            >
            <span class="cta-version">v{version}</span>
          </p>
        </div>

        <div class="hero-cue" aria-hidden="true">
          <span>向下</span>
          <i></i>
        </div>
      </section>

      <!-- 界面模拟：一扇窗 + 侧栏四个导航页，外加侧栏脚注的「设置」。
           radio 驱动，零 JS——入口脚本在 file:// 下不执行，任何依赖 JS 的切页在那种场合都是死图。
           面板里的每一串文字都照 renderer 的现值写：HomePage / DownloadsPage / HistoryPage /
           StatsPage / SettingsPage 的标题、列名、徽标与按钮，不在此处美化或另起一套说法。
           与应用的三处有意偏离都标在对应位置：队列少两列时间、设置只出「引擎」一类、数据是演示值。 -->
      <section class="tour" id="ui">
        <div class="tour-head">
          <p class="block-index">01</p>
          <h2>界面展示</h2>
        </div>

        <input class="tour-radio" type="radio" name="tour" id="tour-home" checked aria-label="首页界面" />
        <input class="tour-radio" type="radio" name="tour" id="tour-queue" aria-label="队列界面" />
        <input class="tour-radio" type="radio" name="tour" id="tour-history" aria-label="历史界面" />
        <input class="tour-radio" type="radio" name="tour" id="tour-stats" aria-label="统计界面" />
        <input class="tour-radio" type="radio" name="tour" id="tour-settings" aria-label="设置界面" />

        <div class="app" role="group" aria-label="MediaGet 应用界面模拟">
          <div class="app-wco">
            <span class="app-brand">MediaGet</span>
            <span class="app-wco-set">设置</span>
            <!-- 真窗由 Windows 在透明带上画三枚符号，renderer 一个按钮也不自绘；这里描出来只为读得出「这是桌面窗口」 -->
            <span class="app-glyphs" aria-hidden="true"><i></i><i></i><i class="is-close"></i></span>
          </div>

          <div class="app-body">
            <aside class="app-side">
              <nav class="app-nav" aria-label="模拟导航">
                <label class="app-nav-item" for="tour-home">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
                  </svg>
                  <span>首页</span>
                </label>
                <label class="app-nav-item" for="tour-queue">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <path points="7 10 12 15 17 10" d="m7 10 5 5 5-5" />
                    <path d="M12 15V3" />
                  </svg>
                  <span>队列</span>
