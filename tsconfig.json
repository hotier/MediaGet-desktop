{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["renderer/src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "types/**/*.ts",
    "shared/**/*.ts",
    "core-adapter/**/*.ts",
    "electron/**/*.ts",
    "renderer/src/**/*.ts",
    "renderer/src/**/*.tsx",
    "tests/**/*.ts",
    "tsup.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
