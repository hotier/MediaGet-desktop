---
/*
 * MediaGet 落地页（Astro 静态页，不参与 renderer 构建，也不 import 应用运行时模块）。
 *
 * 2026-10-20 版式重做（业主给了参考稿）：首屏第一眼是「粘贴一条链接，解析、预览与下载都在你自己的
 * 电脑上」，字标退到导航左上角；首屏下面直接压一扇按 renderer 现值复刻的窗（app-mock.css）。
 * 上一版把字标放大成 h1，整屏只有一个品牌名——读不到产品，也读不到下一步做什么。
 *
 * 三条「不抄第二份」：
 *   1. 平台清单与图标来自 shared/platforms.ts，图标由 scripts/build-landing.cjs 从
 *      renderer/public/logos 镜像到 landing/public/logos（生成物，不入库）。
 *   2. 「能在应用内登录获取 Cookie」那组由 shared/cookie-login.ts 推出（键 → 域名 → 平台），
 *      不在这里列平台名。分组因此与主进程真正的登录窗口同源：改一张表，两组自动跟着变。
 *   3. 版本号来自 version.json（构建时由 build-landing.cjs 写入；仓库内保留一份本地默认值，
 *      未执行脚本也不会拿到空值白屏）。安装包体积与发布日期不抄进页面，那两个数在 Release 那页。
 *
 * 字体只有首屏京华老宋体一份自托管在 landing/public/fonts（2026-10-22 业主定调：
 * 正文全走系统字体栈，不再带 webfont），不引任何 WebFont CDN：整页零第三方请求。
 */
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemeInit from "../components/ThemeInit.astro";
import DownloadCta from "../components/DownloadCta.astro";
import { PLATFORMS } from "../../../shared/platforms";
import { WORK_STAT_SLOTS } from "../../../shared/work-stat";
import { COOKIE_LOGIN_KEYS, COOKIE_LOGIN_TARGETS } from "../../../shared/cookie-login";
import release from "../../version.json";


/* 分享卡是绝对链接（爬虫不解析相对路径）：相对那个文件走出去取，域名仍只写在 astro.config 的 site */
const ogImage = new URL("og.png", Astro.site ?? "https://hotier.github.io/mediaGet-desktop/").href;

// 只有默认提供的平台才上首页：登记了但引擎未验证（enabledByDefault=false）的不在这里承诺。
const supplied = PLATFORMS.filter((platform) => platform.enabledByDefault);
const platformCount = supplied.length;

/* 首屏副文案 = 一句宣传语，由轮换打字机逐句播放（脚本在页面底部，内联、file:// 也执行）。
   第一条完整写进 HTML：没有 JS 或读者要减少动态效果时，它就是一句安静的静态文案。
   三条约束写在这里，改文案时一起守：
     1. 每条 ≤ 15 个全角字（.hero-sub 是一行 nowrap，30em 宽，超了会被裁）；
     2. 不要写半角空格（逐字播放时空格看起来像卡住），要停顿用全角标点；
     3. 三条说的是三件不同的事——顺序即播放顺序，别把同义句排在一起。 */
const heroLines = [
  "粘贴链接，选清晰度，落到硬盘。",
  "不经过任何第三方服务器。",
  "断点续传，关掉再开接着下。",
];

/**
 * 「可在应用内登录获取 Cookie」这一组：Cookie 键 → 登录目标域名 → 注册表里的平台。
 * 任何一环对不上就抛错让 astro build 变红——静默少一组比多一组更难发现。
 */
const loginKeys = new Set(
  COOKIE_LOGIN_KEYS.map((key) => {
    const [domain] = COOKIE_LOGIN_TARGETS[key].domains;
    const platform = PLATFORMS.find((item) => item.domains.includes(domain));
    if (!platform) {
      throw new Error(`登录目标域名 "${domain}" 在 shared/platforms.ts 里找不到对应平台`);
    }
    return platform.key;
  })
);
const canLogin = supplied.filter((platform) => loginKeys.has(platform.key));
const pasteOnly = supplied.filter((platform) => !loginKeys.has(platform.key));

/** 图标光学尺寸分档：源文件 viewBox 比例不同，属落地页自己的视觉元数据，按契约键挂载 */
const iconFit: Record<string, "wide" | "wordmark" | "chip"> = {
  youtube: "wide",
  acfun: "wordmark",
  twitter: "chip",
};

/**
 * 界面模拟里的平台图标与计数标签一律回注册表取，不在这里抄第二份：
 * 查不到就当场抛错让 astro build 变红，比页面上静默少一枚图、少一个字好发现。
 */
const logoBy = new Map(PLATFORMS.map((platform) => [platform.key, platform.iconFile]));
const logo = (key: string) => {
  const file = logoBy.get(key);
  if (!file) throw new Error(`界面模拟引用了未登记的平台键 "${key}"：shared/platforms.ts 里没有它`);
  return file;
};
const statLabel = (key: string) => {
  const slot = WORK_STAT_SLOTS.find((item) => item.key === key);
  if (!slot) throw new Error(`界面模拟引用了未登记的计数字段 "${key}"：shared/work-stat.ts 里没有它`);
  return slot.label;
};

/** 数值取自 renderer/src/dev/mock-bridge.ts 的 bilibili 夹具；这是演示数据，不是实测统计 */
const DEMO_STAT: Record<string, number> = { view: 1284503, danmaku: 8421, like: 98200 };
const statRow = ["view", "danmaku", "like"].map((key) => ({
  label: statLabel(key),
  value: DEMO_STAT[key],
}));

/**
 * 星期轴与 renderer/src/lib/stats.ts 的 WEEKDAYS 同序（索引 = getDay()）。
 * 热力 7 行 × 12 格，一格两小时；真页是 7×24=168 格，这里收一档，168 枚方块在落地页只增体积不增信息。
 * 数字是密度档（0–3），不是计数。
 */
const WEEKDAYS = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
const HEAT = [
  "000001001110",
  "001122101220",
  "012332123321",
  "012331023320",
  "001221012210",
  "000110001110",
  "000011011221",
].map((row) => row.split("").map(Number));

const version = release.version || "0.1.0";
---

<!doctype html>
<!-- 默认浅色：首屏是黑带、正文是浅底（参考稿的明暗节奏）。系统偏好深色时由 head 里的内联脚本翻档，
     翻档发生在首帧之前，不会先闪一帧浅色。 -->
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MediaGet-免费的作品解析平台</title>
    <meta
      name="description"
      content={`MediaGet 是一款 Windows 桌面下载器：解析与下载都在本机完成，链接不经过第三方服务器，直链拿到就落盘。支持 ${platformCount} 个平台，含资源列表预览与断点续传，Cookie 只存本机。`}
    />
    <!-- 首屏是整页最上面那一块，浏览器 UI 跟着它的底色走；切档时由 head 内联脚本改写 -->
    <meta name="theme-color" content="#f7f7f8" />
    <meta property="og:title" content="MediaGet-免费的作品解析平台" />
    <meta
      property="og:description"
      content={`MediaGet 是一款 Windows 桌面下载器：解析与下载都在本机完成，链接不经过第三方服务器，直链拿到就落盘。支持 ${platformCount} 个平台，含资源列表预览与断点续传，Cookie 只存本机。`}
    />
    <meta property="og:type" content="website" />
    <!-- 中文站声明：缺它时部分爬虫（X 偶发）按英文页渲染分享卡。
         不加 twitter:site —— 本仓没有官方 X 账号，不写未实现的承诺。 -->
    <meta property="og:locale" content="zh_CN" />
    <!-- 绝对链接来自 astro.config 的 site（Pages 项目站），页面里不写死域名 -->
    <link rel="canonical" href={Astro.site?.href} />
    <meta property="og:url" content={Astro.site?.href} />
    <meta property="og:site_name" content="MediaGet" />
    <!-- 分享卡：landing/public/og.png（1200×630，scripts/make-icons.cjs 从 brand/ 母版生成） -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MediaGet 字标" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- 页签图标与应用同一个资产（scripts/make-icons.cjs 产出，build-landing 镜像到 public/brand） -->
    <link rel="icon" type="image/png" href="./brand/favicon.png" />
    <!-- 主题初值与开关全站共享：必须在 head 里、赶在首帧前定档（原因见组件注释） -->
    <ThemeInit />
  </head>

  <body>
    <!-- 导航与页脚由 components/SiteNav.astro / SiteFooter.astro 提供：
         文档页与 404 用的是同两个组件，只是锚点前缀与主题开关不同。
         skip-link 在 SiteNav 组件里。 -->
    <SiteNav pagePath="/" isHome />

    <!-- 首屏是一块与正文同色的画布：承诺、一句轮换的宣传语、动作按钮都在这里，窗体的顶边接在下面（见 .tour）。
         原来还有一条四步解析线（01 粘贴链接…04 选择下载），2026-10-20 业主删掉——首屏只留读得完的东西。
         墨色全走 --hero-*，切换主题时整块一起翻。 -->
    <header class="hero" id="top">
      <div class="shell hero-copy">
        <p class="hero-eyebrow">
          <span class="mono">v{version}</span>
        </p>

        <!-- 首屏的主视觉就是这句承诺本身，纯中文、三行。标题字体是京华老宋体子集，
             自托管在 public/fonts/（见 global.css），运行期不向任何 CDN 发请求。
             改这句文案要同时重裁老宋那份子集。 -->
        <h1 class="hero-title">
          <span class="hero-title-cn">粘贴一条链接，<br />从解析到下载，<br />都在这台电脑上。</span>
        </h1>

        <div class="hero-row">
          <!-- 副文案：一句话占一行，脚本接手后逐句打字/擦除/换句。第一句在这里写死，
               所以无 JS、或读者勾了「减少动态效果」时，它就是一句静态宣传语。
               光标默认不显示，脚本给 .hero-sub 加上 is-typing 才出来。 -->
          <p class="hero-sub">
            <span id="heroTicker">{heroLines[0]}</span><span class="hero-caret" aria-hidden="true"
            ></span>
          </p>
          <div class="hero-action-col">
            <div class="hero-actions">
              <!-- 「下载 Windows 版」主按钮：与下载页共用 components/DownloadCta.astro -->
              <DownloadCta />
            </div>
            <p class="hero-hint">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 16v-4" />
                <path d="M12 8h.01" />
              </svg>
              适用于 Windows 10 / 11
            </p>
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- 界面模拟：一扇窗 + 侧栏四个导航页，外加侧栏脚注的「设置」。
           radio 驱动，零 JS——入口脚本在 file:// 下不执行，任何依赖 JS 的切页在那种场合都是死图。
           面板里的每一串文字都照 renderer 的现值写：HomePage / DownloadsPage / HistoryPage /
           StatsPage / SettingsPage 的标题、列名、徽标与按钮，不在此处美化或另起一套说法。
           与应用的三处有意偏离都标在对应位置：队列少两列时间、设置只出「引擎」一类、数据是演示值。
           这扇窗紧接在首屏黑底之后、同一底色：它是首屏的一部分，不再另起「01 界面展示」的段头。 -->
      <section class="tour reveal" id="ui" aria-label="界面展示">
        <input class="tour-radio" type="radio" name="tour" id="tour-home" checked aria-label="首页界面" />
        <input class="tour-radio" type="radio" name="tour" id="tour-queue" aria-label="队列界面" />
        <input class="tour-radio" type="radio" name="tour" id="tour-history" aria-label="历史界面" />
        <input class="tour-radio" type="radio" name="tour" id="tour-stats" aria-label="统计界面" />
        <input class="tour-radio" type="radio" name="tour" id="tour-settings" aria-label="设置界面" />

        <div class="app" role="group" aria-label="MediaGet 应用界面模拟">
          <div class="app-wco">
            <!-- 品牌位照 renderer 的现值写：真窗这里就是 BrandLogo（18px 字标），不再是一串文字 -->
            <span class="app-brand">
              <img data-ink="on-dark" src="./brand/logo-lockup-on-dark.png" alt="" width="347" height="80" />
              <img data-ink="on-light" src="./brand/logo-lockup-on-light.png" alt="" width="347" height="80" />
            </span>
            <span class="app-wco-set">设置</span>
            <!-- 真窗由 Windows 在透明带上画三枚符号，renderer 一个按钮也不自绘；这里描出来只为读得出「这是桌面窗口」 -->
            <span class="app-glyphs" aria-hidden="true"><i></i><i></i><i class="is-close"></i></span>
          </div>

          <div class="app-body">
            <aside class="app-side">
              <nav class="app-nav" aria-label="模拟导航">
                <label class="app-nav-item" for="tour-home">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
                  </svg>
                  <span>首页</span>
                </label>
                <label class="app-nav-item" for="tour-queue">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <path points="7 10 12 15 17 10" d="m7 10 5 5 5-5" />
                    <path d="M12 15V3" />
                  </svg>
                  <span>队列</span>
                  <b class="app-nav-count" title="2 个任务进行中">2</b>
                </label>
                <label class="app-nav-item" for="tour-history">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                    <path d="M3 3v5h5" />
                    <path d="M12 7v5l4 2" />
                  </svg>
                  <span>历史</span>
                </label>
                <label class="app-nav-item" for="tour-stats">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                    <path d="m7 13 3-3 4 4 5-5" />
                  </svg>
                  <span>统计</span>
                </label>
              </nav>

              <!-- 设置态的侧栏整壳换成分类表（真应用的 settingsMode 就是这个动作）。
                   分类画成不可点：这里只复刻「引擎」一面，做成能点就等于承诺另外四面也在。 -->
              <div class="app-side-set">
                <label class="app-back" for="tour-home">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                  </svg>
                  <span>返回</span>
                  <em>Esc</em>
                </label>
                <span class="app-cat">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M3 20h9M16 20h5" />
                    <path d="M14 2v4M8 10v4M16 18v4" />
                  </svg>
                  <span>通用</span>
                </span>
                <span class="app-cat">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <path d="m7 10 5 5 5-5" />
                    <path d="M12 15V3" />
                  </svg>
                  <span>下载</span>
                </span>
                <span class="app-cat">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2a1 1 0 0 0 0 20l.25 0a1.75 1.75 0 0 0 1.4-2.8l-.3-.4a1.75 1.75 0 0 1 1.4-2.8h2.25a5 5 0 0 0 5-5 10 9 0 0 0-10-9z" />
                    <circle cx="6.5" cy="12.5" r=".5" />
                    <circle cx="8.5" cy="7.5" r=".5" />
                    <circle cx="13.5" cy="6.5" r=".5" />
                    <circle cx="17.5" cy="10.5" r=".5" />
                  </svg>
                  <span>外观</span>
                </span>
                <span class="app-cat is-on">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="4" y="4" width="16" height="16" rx="2" />
                    <rect x="9" y="9" width="6" height="6" rx="1" />
                    <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" />
                  </svg>
                  <span>引擎</span>
                </span>
                <span class="app-cat">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" />
                    <path d="m15 9-6 6" />
                    <path d="M9 9h.01" />
                    <path d="M15 15h.01" />
                  </svg>
                  <span>关于</span>
                </span>
              </div>

              <label class="app-nav-item app-side-foot" for="tour-settings">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
                  />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <span>设置</span>
              </label>
            </aside>

            <div class="app-main">
              <!-- 首页：解析输入 + 结果卡 + 右栏队列轨（QueueRail 常驻在首页右侧，不是独立页） -->
              <section class="app-page" data-page="home">
                <div class="app-home">
                  <div class="app-home-col">
                    <div class="app-input">
                      <p class="app-ph">粘贴分享链接或整段分享文案，多条用空格、换行隔开，Ctrl+K 任意页面直达…</p>
                      <p class="app-hint">识别为 哔哩哔哩（从分享文案提取链接）</p>
                      <div class="app-input-bar">
                        <span class="app-btn">导入文件</span>
                        <span class="app-btn is-quiet">清除</span>
                        <span class="app-btn is-primary">解析</span>
                      </div>
                    </div>

                    <div class="app-card">
                      <div class="app-cover">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 4 12 8-12 8z" /></svg>
                        <em>06:12</em>
                      </div>
                      <div class="app-card-main">
                        <p class="app-title">【4K 修复】二十年前的城市夜景胶片，一帧一帧重新上色</p>
                        <p class="app-author"><i></i>胶片修复所<span class="app-div">影视剪辑</span></p>
                        <p class="app-counters">
                          {
                            statRow.map((item) => (
                              <span>
                                {item.label} <b>{item.value.toLocaleString("zh-CN")}</b>
                              </span>
                            ))
                          }
                        </p>
                        <div class="app-res">
                          <p class="app-res-bar">
                            资源列表
                            <span class="app-div">3 / 5 已选</span>
                            <span class="app-btn is-quiet">收起资源</span>
                          </p>
